# Enable rewriting
RewriteEngine On

# Force HTTPS (must run before the SPA fallback, which would otherwise [L]-stop first)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

# Redirect www to apex, over HTTPS
RewriteCond %{HTTP_HOST} ^www\.swizzleshizzle\.com$ [NC]
RewriteRule ^(.*)$ https://swizzleshizzle.com/$1 [L,R=301]

# Serve the SPA for the /archive page even once public/archive/ exists as a real
# directory (the generic fallback's !-d test would otherwise skip it, and Apache
# would serve a bare directory/403). Frozen builds under /archive/v1/ etc. are
# real dirs and continue to be served directly.
RewriteRule ^archive/?$ index.html [L]

# If the request is not for a file, directory, or symlink, redirect to index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-l
RewriteRule ^ index.html [QSA,L]

# Set security headers
<IfModule mod_headers.c>
    # Protect against XSS attacks
    Header set X-XSS-Protection "1; mode=block"
    
    # Prevent MIME-sniffing
    Header set X-Content-Type-Options "nosniff"
    
    # Referrer policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # HTTP Strict Transport Security (1 year). No includeSubDomains/preload yet —
    # add those once HTTPS is confirmed working across every subdomain.
    Header always set Strict-Transport-Security "max-age=31536000"

    # Content Security Policy - allows web workers, CDNs, and EmailJS.
    # 'unsafe-inline' dropped from script-src (no inline executable scripts remain;
    # the JSON-LD block is non-executable). 'unsafe-eval' retained: Three.js/Vanta may
    # require it — test removal on staging before dropping. frame-ancestors blocks framing.
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data:; font-src 'self' https://cdn.jsdelivr.net https://fonts.gstatic.com; connect-src 'self' https://cdn.jsdelivr.net https://fonts.gstatic.com https://api.emailjs.com; frame-ancestors 'self'"
</IfModule>

# Always revalidate the version manifest so a freshly-cut version appears
# immediately (overrides the 1-week application/json cache set below).
<IfModule mod_headers.c>
    <FilesMatch "versions\.json$">
        Header set Cache-Control "no-cache, must-revalidate"
        Header unset Expires
    </FilesMatch>
</IfModule>

# Enable compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Set caching headers
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Cache HTML files for 1 hour
    ExpiresByType text/html "access plus 1 hour"
    
    # Cache CSS, JavaScript, and JSON files for 1 week
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType application/json "access plus 1 week"
    
    # Cache images, fonts, and other static assets for 1 month
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType application/font-woff "access plus 1 month"
    ExpiresByType application/font-woff2 "access plus 1 month"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 month"
    ExpiresByType application/x-font-ttf "access plus 1 month"
    
    # Set a default expiration time for all other file types
    ExpiresDefault "access plus 2 days"
</IfModule>
